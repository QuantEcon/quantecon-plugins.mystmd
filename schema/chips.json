{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantecon.github.io/quantecon-plugins.mystmd/schema/chips.json",
  "title": "qe-dv chips",
  "description": "The root node emitted by the datavis `chips` directive: a wrapping set of small labelled chips, each an optional monospaced id and an optional short label carrying a tone hint. The structured data rides on `items`; `children` carry a portable fallback rendering of the same data, one list item per entry of `items`. The data lives exactly twice — once as `items`, once as the text of the chip spans — and a chip span carries a `class` and nothing else. The schema checks that both renderings are present and well formed, that the two lengths agree (see `$defs/chipCountFollowsItems`), and that the set-level `variant` and `tone` agree with every entry of `items` and with every span's class tokens; that the i-th span's children spell out `items[i]` is asserted by the test suite, which JSON Schema cannot express.",
  "type": "object",
  "required": [
    "type",
    "class",
    "contract",
    "primitive",
    "variant",
    "tone",
    "items",
    "children"
  ],
  "additionalProperties": true,
  "properties": {
    "type": {
      "type": "string",
      "const": "div"
    },
    "class": {
      "type": "string",
      "description": "Space-separated class tokens, exactly as the directive normalises them: the family token `qe-dv`, the primitive token `qe-dv-chips`, the derived token `qe-dv-chips--<variant>`, then any author tokens from `:class:`, deduplicated and single-space joined.",
      "allOf": [
        {
          "type": "string",
          "pattern": "^\\S+( \\S+)*$",
          "description": "Single-space joined, with no leading or trailing whitespace."
        },
        {
          "type": "string",
          "pattern": "(^| )qe-dv( |$)"
        },
        {
          "type": "string",
          "pattern": "(^| )qe-dv-chips( |$)"
        }
      ]
    },
    "contract": {
      "type": "string",
      "const": "1.0"
    },
    "primitive": {
      "type": "string",
      "const": "chips"
    },
    "variant": {
      "$ref": "#/$defs/variant",
      "description": "Shape of every chip in the set, resolved onto every entry of `items`."
    },
    "tone": {
      "$ref": "#/$defs/tone",
      "description": "Set-level tone hint, and the tone of every chip: a set is uniform in tone. Already resolved onto every entry of `items`, so a consumer reading a chip never falls back to the root."
    },
    "mark": {
      "$ref": "#/$defs/mark",
      "description": "Decorative glyph drawn before every chip. Also rendered into each chip span, so the fallback shows it too."
    },
    "items": {
      "type": "array",
      "description": "The chips, in render order. Entry i is rendered as the text of the i-th chip span in `children`; the schema pins the two lengths together and the test suite checks that the span spells the entry out. May be empty.",
      "items": {
        "$ref": "#/$defs/chip"
      }
    },
    "children": {
      "type": "array",
      "description": "Exactly one node: a `list` of chip spans when `items` is non-empty, otherwise a `paragraph` holding the empty-set notice.",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object"
      }
    },
    "naLabel": false,
    "label": false,
    "identifier": false,
    "html_id": false
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "variant"
        ],
        "properties": {
          "variant": {
            "type": "string",
            "const": "pill"
