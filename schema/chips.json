        "description": "`variant` is resolved onto every chip and derives a class token on the root and on every chip span.",
        "properties": {
          "class": {
            "type": "string",
            "pattern": "(^| )qe-dv-chips--pill( |$)"
          },
          "items": {
            "type": "array",
            "items": {
