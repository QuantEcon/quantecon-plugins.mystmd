                                    "type": "string",
                                    "pattern": "(^| )qe-dv-chips__chip--pill( |$)"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
