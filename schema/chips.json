  "$defs": {
    "tone": {
      "type": "string",
      "enum": [
        "neutral",
        "accent",
        "good",
        "warn",
        "bad"
      ],
      "description": "The family tone vocabulary, closed. A hint only: never a colour and never a threshold."
    },
    "variant": {
      "type": "string",
      "enum": [
        "pill",
        "tag"
      ],
      "description": "`pill` is the bordered, fully rounded chip; `tag` is the compact filled chip. Closed set."
    },
    "mark": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4,
      "description": "A short glyph, not a label."
    },
    "chip": {
      "type": "object",
      "description": "One chip, fully resolved: `tone` and `variant` are always present, so a consumer reading one entry of `items` never falls back to the root.",
      "required": [
        "tone",
        "variant"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string"
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Short identifier, rendered monospaced — an `inlineCode` node in the fallback."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Plain-text label. Chips are small: inline markup is flattened at build time."
        },
        "tone": {
          "$ref": "#/$defs/tone",
          "description": "The chip's resolved tone, which is the set's `tone`."
        },
        "variant": {
          "$ref": "#/$defs/variant",
          "description": "The chip's resolved shape, which is the set's `variant`."
        },
        "mark": {
          "$ref": "#/$defs/mark"
        }
      }
    },
    "chipCountFollowsItems": {
      "description": "`items.length === children[0].children.length`, encoded exactly for sets of one to twenty-four chips. Without it a set can carry sixteen chips in `items` and print one in its fallback, and nothing complains — which is precisely how a fallback rots. That the i-th span's children spell out `items[i]` is the AST conformance test's, because JSON Schema cannot compare two values in one document.",
      "anyOf": [
        {
          "type": "object",
          "description": "The empty set: no chips, and the sibling `allOf` pins the single child to the empty-set notice.",
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
