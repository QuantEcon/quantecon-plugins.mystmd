            "required": [
              "type",
              "children"
            ],
            "additionalProperties": true,
            "properties": {
              "type": {
                "type": "string",
                "const": "emphasis"
              },
              "children": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "value"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "value": {
                      "type": "string",
                      "const": "None."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
