    "chipSpan": {
      "type": "object",
      "description": "A chip span: a styling hook around the plain text of one chip. It carries a `class` and nothing else — no `contract`, no `primitive`, no `part`, and no second copy of the entry of `items` it renders, so the datum lives exactly twice. It carries no `label`, `identifier` or `html_id` either: `myst-cli`'s embed transform deletes all three from any non-reference node. Its class tokens are derived from the set's resolved `variant` and `tone`.",
      "required": [
        "type",
        "class",
        "children"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "span"
        },
        "class": {
          "type": "string",
          "allOf": [
            {
              "type": "string",
              "pattern": "^\\S+( \\S+)*$"
            },
            {
              "type": "string",
              "pattern": "(^| )qe-dv( |$)"
            },
            {
              "type": "string",
              "pattern": "(^| )qe-dv-chips__chip( |$)"
            }
          ]
        },
        "children": {
          "type": "array",
          "description": "The chip as plain inline content: the mark, the id as `inlineCode`, and the label as text, with adjacent text runs merged. One to three nodes.",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/inline"
          }
        },
        "contract": false,
        "primitive": false,
        "part": false,
        "chip": false,
        "label": false,
        "identifier": false,
        "html_id": false
      }
    },
    "inline": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "text",
            "inlineCode"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "The rendered text. Never empty: a chip span whose text runs are blank renders nothing."
        }
      }
    },
    "emptyNotice": {
      "type": "object",
      "description": "The empty-set fallback: a paragraph holding an emphasised `None.`",
      "required": [
        "type",
        "children"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
