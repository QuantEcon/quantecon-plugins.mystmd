    "fallbackTable": {
      "type": "object",
      "required": [
        "type",
        "children"
      ],
      "description": "The fallback table, emitted bare: no wrapping container, no caption, no label, no identifier and no html_id, so it is never enumerated as \"Table N\" and never registered as a cross-reference target. All of it is enforced rather than merely asserted: the wrapping container and the caption by the `type` const and the row items, the three identity properties by the `not`s below.",
      "properties": {
        "type": {
          "const": "table"
        },
        "label": {
          "not": {},
          "description": "Never present. myst-cli's embed transform runs selectAll('[identifier],[label],[html_id]') over an embedded subtree and deletes all three from every node that is not a crossReference, cite, footnote node, captionNumber or link — so a div, table, row or cell carrying one loses it, and only when the page is embedded elsewhere. The family therefore emits none of the three on any node. A `label` key inside the stats array is a different thing and is required there."
        },
        "identifier": {
          "not": {},
          "description": "Never present, for the same reason as label."
        },
        "html_id": {
          "not": {},
          "description": "Never present, for the same reason as label."
        },
        "children": {
          "type": "array",
          "minItems": 2,
          "description": "Row 0 is the header row; every row after it is one stat, in the stats array's order. Exactly one row in the table is a header row — contains/maxContains says so for any size, and rowCountFollowsStats pins it at index 0, with n data rows after it, for the one-to-twelve-tile blocks it enumerates.",
          "items": {
            "$ref": "#/$defs/anyRow"
          },
          "contains": {
            "$ref": "#/$defs/headerRow"
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    "anyRow": {
      "description": "Any row of the fallback table: the header row, or one stat. The two are mutually exclusive — a header row carries header: true on every cell, and no cell of a data row may carry it — so oneOf is exact rather than merely convenient.",
      "oneOf": [
        {
          "$ref": "#/$defs/headerRow"
        },
        {
          "$ref": "#/$defs/tableRow"
        }
      ]
    },
    "headerRow": {
      "type": "object",
      "required": [
        "type",
        "children"
      ],
      "description": "Row 0, and the only header row: the column vocabulary the reader of a plain build needs, given that this primitive invents its columns rather than taking them from the author. Two cells, or three when the block has a note column. Every cell carries header: true, and no cell in any other row does.",
      "properties": {
        "type": {
          "const": "tableRow"
        },
        "label": {
          "not": {},
          "description": "Never present. myst-cli's embed transform runs selectAll('[identifier],[label],[html_id]') over an embedded subtree and deletes all three from every node that is not a crossReference, cite, footnote node, captionNumber or link — so a div, table, row or cell carrying one loses it, and only when the page is embedded elsewhere. The family therefore emits none of the three on any node. A `label` key inside the stats array is a different thing and is required there."
